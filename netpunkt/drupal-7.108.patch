+   *   character set.
+   */
+  protected function noPadCollation() {
+    $collation = $this->authnameCollation();
+    $charset = substr($collation, 0, strpos($collation, '_'));
+    $candidates = array($charset . '_0900_ai_ci', $charset . '_general_nopad_ci', $charset . '_unicode_nopad_ci');
+    foreach ($candidates as $candidate) {
+      if (db_query('SHOW COLLATION WHERE Collation = :collation', array(':collation' => $candidate))->fetchField()) {
+        return $candidate;
+      }
+    }
+    return FALSE;
+  }
+
+  /**
+   * Redefines {authmap}.authname with the given collation, keeping its key.
