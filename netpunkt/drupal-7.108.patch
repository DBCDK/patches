+/**
+ * Tests that {authmap}.authname is matched case-sensitively.
+ */
+class UserAuthmapCaseSensitivityTestCase extends DrupalWebTestCase {
+
+  /**
+   * The account the test authname is mapped to.
+   *
+   * @var object
+   */
+  protected $account;
+
+  public static function getInfo() {
+    return array(
+      'name' => 'Authmap case sensitivity',
+      'description' => 'Tests that external authentication names are matched case-sensitively, both by the database column and by the functions that read it.',
+      'group' => 'User',
+    );
+  }
+
+  protected function setUp() {
+    parent::setUp();
+
+    require_once DRUPAL_ROOT . '/includes/update.inc';
+    module_load_include('install', 'user');
+
+    $this->account = $this->drupalCreateUser();
+    user_set_authmaps($this->account, array('authname_poll' => 'kathy'));
+  }
+
+  /**
+   * Returns TRUE if the site runs on MySQL or MariaDB.
+   */
+  protected function isMysql() {
+    return Database::getConnection()->databaseType() == 'mysql';
+  }
+
+  /**
+   * Returns the collation of {authmap}.authname, or NULL if not on MySQL.
+   */
+  protected function authnameCollation() {
+    if (!$this->isMysql()) {
+      return NULL;
+    }
+    $column = db_query("SHOW FULL COLUMNS FROM {authmap} LIKE 'authname'")->fetchAssoc();
+    return $column['Collation'];
+  }
+
+  /**
+   * Redefines {authmap}.authname with or without the binary flag.
+   *
+   * Used to reproduce the pre-update state of a site whose column still uses
+   * a case-insensitive collation.
+   *
+   * @param bool $binary
+   *   Whether the column should be declared binary.
+   */
+  protected function setAuthnameBinary($binary) {
+    $schema = drupal_get_schema_unprocessed('user', 'authmap');
+    $spec = $schema['fields']['authname'];
+    if (!$binary) {
+      unset($spec['binary']);
+    }
+    db_drop_unique_key('authmap', 'authname');
+    db_change_field('authmap', 'authname', 'authname', $spec);
+    db_add_unique_key('authmap', 'authname', array('authname'));
+  }
+
+  /**
+   * Returns a case-insensitive NO PAD collation for {authmap}, if any.
+   *
+   * MySQL 8 defaults to such collations (utf8mb4_0900_ai_ci) and MariaDB
+   * offers them as *_nopad_ci. Under them trailing spaces are significant, so
+   * 'kathy' and 'kathy ' can coexist despite the unique key on authname.
+   *
+   * @return string|false
